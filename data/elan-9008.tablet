# ELAN touchscreen/pen sensor present in the ASUS ROG Flow Z13 2025 GZ302EA 
# 13.4-inch 16:10 aspect ratio
# sysinfo.mKfnOQgtbn.tar.gz
# https://github.com/linuxwacom/wacom-hid-descriptors/issues/478

[Device]
# Name is the same as the ELAN touchscreen/pen sensor in the ASUS ZenBook Duo UX8406MA, but the PID is unique
Name=ELAN9008:00
ModelName=
DeviceMatch=i2c|04f3|43c7
IntegratedIn=Display;System;
Styli=@generic-with-eraser;

[Features]
Stylus=true
Touch=true
